main() {
    # Parse args
    local quick_mode=false
    local config_file=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -q|--quick)  quick_mode=true; shift ;;
            -c|--config)
                if [[ -z "${2:-}" ]]; then
                    echo -e "${RED}ERROR: --config requires a file argument${RESET}" >&2
                    usage
                fi
                config_file="$2"; shift 2 ;;
            -h|--help)   usage ;;
            -*)          echo -e "${RED}Unknown option: $1${RESET}" >&2; usage ;;
            *)           break ;;
        esac
    done

    # Resolve input file: positional arg, or INPUT from config file
    local input_file=""
    if [[ $# -ge 1 ]]; then
        input_file="$1"
    elif [[ -n "$config_file" ]]; then
        # Peek at the config file for INPUT= before full parsing
        input_file=$(grep -m1 '^INPUT=' "$config_file" | cut -d= -f2-)
    fi

    if [[ -z "$input_file" ]]; then
        usage
    fi

    if [[ ! -f "$input_file" ]]; then
        echo -e "${RED}ERROR: File not found: ${input_file}${RESET}" >&2
        exit 1
    fi

    check_dependencies

    # Probe audio
    probe_audio "$input_file"

    # Interactive dialogue, quick defaults, or config file
    if [[ -n "$config_file" ]]; then
        load_config "$config_file" "$input_file"
    elif [[ "$quick_mode" == true ]]; then
        quick_defaults "$input_file"
    else
        interactive_dialogue "$input_file"
    fi

    # Check for existing output file
    if [[ -f "$OUTPUT_FILE" ]]; then
        echo -e "${YELLOW}Output file already exists: ${OUTPUT_FILE}${RESET}" >&2
        local overwrite
        overwrite=$(ask "Overwrite? (y/n)" "n")
        if [[ "$overwrite" != "y" && "$overwrite" != "Y" && "$overwrite" != "yes" ]]; then
            echo -e "${RED}Aborted.${RESET}" >&2
            exit 1
        fi
    fi

    # Parse playback speed
    parse_playback_speed "$PLAYBACK_SPEED_INPUT" "$AUDIO_SAMPLE_RATE"

    # Load preset
    source "${PRESETS_DIR}/${PRESET}.conf"

    # Encoding override defaults (preset may override any of these)
    H264_PROFILE="${H264_PROFILE:-high}"
    H264_LEVEL="${H264_LEVEL:-}"
    H264_PRESET="${H264_PRESET:-slow}"
    H264_CRF="${H264_CRF:-18}"
    H264_EXTRA_PARAMS="${H264_EXTRA_PARAMS:-}"
    H264_BFRAMES="${H264_BFRAMES:-}"
    H264_REFS="${H264_REFS:-}"
    AUDIO_BITRATE="${AUDIO_BITRATE:-256k}"
    AUDIO_SAMPLE_RATE="${AUDIO_SAMPLE_RATE:-}"
    AUDIO_CHANNELS="${AUDIO_CHANNELS:-}"

    # Calculate effective duration
    local effective_duration
    effective_duration=$("$PYTHON" -c "print(f'{${AUDIO_DURATION} * ${SPEED_FACTOR}:.6f}')")

    echo -e "${DIM}──────────────────────────────────────────────────────${RESET}"
    echo -e "${BOLD}Generating video...${RESET}"
    echo -e "${DIM}Effective duration: ${effective_duration}s | Preset: ${PRESET} (${VIDEO_WIDTH}x${VIDEO_HEIGHT})${RESET}"
    echo ""

    # Create temp directory
    TMPDIR=$(mktemp -d /tmp/frvg.XXXXXX)
    trap "rm -rf ${TMPDIR}" EXIT

    # Stage 1: Prepare audio
    echo -e "  ${CYAN}[1/5]${RESET} Preparing audio..."
    local prepared_audio="${TMPDIR}/prepared_audio.wav"
    prepare_audio "$input_file" "$prepared_audio" "$EFFECTIVE_RATE" "$SPEED_FACTOR" "$NORMALIZE_AUDIO"

    # Stage 2: Render info panel (first, to get auto-sized height)
    echo -e "  ${CYAN}[2/5]${RESET} Rendering info panel..."
    local info_png="${TMPDIR}/info_panel.png"
    local panel_output
    local dynamic_time_flag=""
    if [[ "$SHOW_TIMECODE" == "y" || "$SHOW_TIMECODE" == "Y" || "$SHOW_TIMECODE" == "yes" ]]; then
        dynamic_time_flag="--dynamic-time"
    fi
    local animated_map_flag=""
    if [[ -n "$META_COORDINATES" ]]; then
        animated_map_flag="--animated-map"
    fi

    panel_output=$("$PYTHON" "${LIB_DIR}/render_info_panel.py" \
        --output "$info_png" \
        --width "$VIDEO_WIDTH" \
        --font-size "$INFO_FONT_SIZE" \
        --filename "$input_file" \
        --subject "$META_SUBJECT" \
        --recorder "$META_RECORDER" \
        --datetime "$META_DATETIME" \
        --location "$META_LOCATION" \
        --playback-speed "$PLAYBACK_LABEL" \
        --sample-info "${AUDIO_SAMPLE_RATE}HZ ${AUDIO_BIT_DEPTH}BIT${AUDIO_FORMAT:+ $AUDIO_FORMAT}" \
        --coordinates "$META_COORDINATES" \
        --max-value-chars "${MAX_VALUE_CHARS:-32}" \
        $dynamic_time_flag $animated_map_flag)

    # Extract auto-calculated panel height and timecode position
    local INFO_PANEL_HEIGHT
    INFO_PANEL_HEIGHT=$(echo "$panel_output" | grep "panel_height=" | cut -d= -f2)
    TIMECODE_X=$(echo "$panel_output" | grep "timecode_x=" | cut -d= -f2 || true)
    TIMECODE_Y=$(echo "$panel_output" | grep "timecode_y=" | cut -d= -f2 || true)

    # Extract scroll fields (for drawtext ticker animation)
    SCROLL_FIELDS=()
    while IFS= read -r line; do
        SCROLL_FIELDS+=("$line")
    done < <(echo "$panel_output" | grep "^scroll_field=" || true)
    SCROLL_VALUE_X=$(echo "$panel_output" | grep "scroll_value_x=" | cut -d= -f2 || true)
    SCROLL_MAX_CHARS=$(echo "$panel_output" | grep "scroll_max_chars=" | cut -d= -f2 || true)

    # Extract map overlay position (for animated map)
    local MAP_X MAP_Y MAP_SIZE MAP_FRAMES_DIR=""
    MAP_X=$(echo "$panel_output" | grep "map_x=" | cut -d= -f2 || true)
    MAP_Y=$(echo "$panel_output" | grep "map_y=" | cut -d= -f2 || true)
    MAP_SIZE=$(echo "$panel_output" | grep "map_size=" | cut -d= -f2 || true)

    # Calculate spectrogram height from remaining space (respecting safe zones)
    local safe_top="${SAFE_TOP:-0}"
    local safe_bottom="${SAFE_BOTTOM:-0}"
    local SPEC_HEIGHT
    if [[ -n "$PHOTO_PATH" ]]; then
        SPEC_HEIGHT=$((VIDEO_HEIGHT - INFO_PANEL_HEIGHT - PHOTO_BAND_HEIGHT - safe_top - safe_bottom))
    else
        SPEC_HEIGHT=$((VIDEO_HEIGHT - INFO_PANEL_HEIGHT - safe_top - safe_bottom))
    fi

    # Stage 3: Generate spectrogram
    local spec_png="${TMPDIR}/spectrogram.png"
    local spec_total_w
    spec_total_w=$(calc_spec_dimensions "$effective_duration" "$VIDEO_WIDTH" "$SPEC_PPS")

    local spec_script="generate_spectrogram.py"
    if [[ "$SPEC_METHOD" == "reassigned" ]]; then
        spec_script="generate_spectrogram_reassigned.py"
        echo -e "  ${CYAN}[3/5]${RESET} Generating reassigned spectrogram (this is slower)..."
    else
        echo -e "  ${CYAN}[3/5]${RESET} Generating spectrogram..."
    fi

    "$PYTHON" "${LIB_DIR}/${spec_script}" \
        --input "$input_file" \
        --output "$spec_png" \
        --width "$spec_total_w" \
        --height "$SPEC_HEIGHT" \
        --colormap inferno \
        --freq-min "$FREQ_MIN" \
        --freq-max "$FREQ_MAX" \
        --original-sr "$AUDIO_SAMPLE_RATE" \
        --fft-window "$FFT_WINDOW" \
        --dynamic-range "$DYNAMIC_RANGE"

    # Stage 4: Render overlays
    echo -e "  ${CYAN}[4/6]${RESET} Rendering frequency scale overlay..."
    local freq_scale_png="${TMPDIR}/freq_scale.png"
    "$PYTHON" "${LIB_DIR}/render_freq_scale.py" \
        --output "$freq_scale_png" \
        --width "$VIDEO_WIDTH" \
        --height "$SPEC_HEIGHT" \
        --freq-min "$FREQ_MIN" \
        --freq-max "$FREQ_MAX" \
        --font-size "$INFO_FONT_SIZE"

    # Stage 5: Generate map zoom animation (if coordinates provided)
    if [[ -n "${MAP_SIZE:-}" && "$MAP_SIZE" -gt 0 ]] 2>/dev/null; then
        echo -e "  ${CYAN}[5/6]${RESET} Generating map zoom animation..."
        MAP_FRAMES_DIR="${TMPDIR}/map_frames"
        "$PYTHON" "${LIB_DIR}/render_map_animation.py" \
            --output-dir "$MAP_FRAMES_DIR" \
            --coordinates "$META_COORDINATES" \
            --size "$MAP_SIZE" \
            --duration "$effective_duration" \
            --fps "$FPS"
    else
        echo -e "  ${CYAN}[5/6]${RESET} ${DIM}Map animation skipped (no coordinates)${RESET}"
    fi

    # Stage 6: Compose video
    echo -e "  ${CYAN}[6/6]${RESET} Compositing video with ffmpeg..."
    # Timecode: pass datetime if enabled, empty string otherwise
    local tc_datetime=""
    if [[ "$SHOW_TIMECODE" == "y" || "$SHOW_TIMECODE" == "Y" || "$SHOW_TIMECODE" == "yes" ]]; then
        tc_datetime="$META_DATETIME"
    fi

    build_ffmpeg_command \
        "$spec_png" \
        "$info_png" \
        "$prepared_audio" \
        "$OUTPUT_FILE" \
        "$PHOTO_PATH" \
        "$spec_total_w" \
        "$VIDEO_WIDTH" \
        "$SPEC_HEIGHT" \
        "$INFO_PANEL_HEIGHT" \
        "$effective_duration" \
        "$FPS" \
        "$VIDEO_WIDTH" \
        "$VIDEO_HEIGHT" \
        "$PHOTO_BAND_HEIGHT" \
        "$freq_scale_png" \
        "$tc_datetime" \
        "$SPEED_FACTOR" \
        "$INFO_FONT_SIZE" \
        "$TIMECODE_X" \
        "$TIMECODE_Y" \
        "${SCROLL_VALUE_X:-}" \
        "${SCROLL_MAX_CHARS:-}" \
        "${MAP_FRAMES_DIR:-}" \
        "${MAP_X:-}" \
        "${MAP_Y:-}" \
        "${MAP_SIZE:-}" \
        ${SCROLL_FIELDS[@]+"${SCROLL_FIELDS[@]}"}

    echo ""
    echo -e "${GREEN}${BOLD}Done!${RESET} Output: ${OUTPUT_FILE}"

    # Print file info
    local filesize
    filesize=$(du -h "$OUTPUT_FILE" | cut -f1)
    echo -e "${DIM}Size: ${filesize}${RESET}"

    # Export metadata text file alongside the video
    local txt_file="${OUTPUT_FILE%.*}.txt"
    {
        [[ -n "$META_SUBJECT" ]]     && echo "SUBJECT: ${META_SUBJECT}"
        [[ -n "$META_DATETIME" ]]    && echo "TIME: ${META_DATETIME}"
        [[ -n "$META_LOCATION" ]]    && echo "LOCATION: ${META_LOCATION}"
        [[ -n "$META_COORDINATES" ]] && echo "COORDINATES: ${META_COORDINATES}"
        [[ -n "$META_RECORDER" ]]    && echo "EQUIPMENT: ${META_RECORDER}"
    } > "$txt_file"
    echo -e "${DIM}Metadata: ${txt_file}${RESET}"
}

main "$@"
