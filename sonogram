#!/usr/bin/env bash
set -euo pipefail

# ============================================================================
# sonogram
#
# Generate a video from a WAV audio recording with scrolling logarithmic
# spectrogram, playback cursor, metadata overlay, and optional photo.
# ============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="${SCRIPT_DIR}/lib"
PRESETS_DIR="${SCRIPT_DIR}/presets"
VENV_DIR="${SCRIPT_DIR}/.venv"
PYTHON="${VENV_DIR}/bin/python3"

# Colors for terminal output
BOLD='\033[1m'
DIM='\033[2m'
CYAN='\033[36m'
GREEN='\033[32m'
YELLOW='\033[33m'
RED='\033[31m'
RESET='\033[0m'

# ============================================================================
# Dependency check
# ============================================================================
check_dependencies() {
    local missing=()
    command -v ffmpeg  >/dev/null 2>&1 || missing+=(ffmpeg)
    command -v ffprobe >/dev/null 2>&1 || missing+=(ffprobe)
    command -v sox     >/dev/null 2>&1 || missing+=(sox)
    command -v python3 >/dev/null 2>&1 || missing+=(python3)

    if [[ ${#missing[@]} -gt 0 ]]; then
        echo -e "${RED}ERROR: Missing system dependencies: ${missing[*]}${RESET}" >&2
        echo "" >&2
        echo "  macOS:         brew install ffmpeg sox python3" >&2
        echo "  Ubuntu/Debian: sudo apt install ffmpeg sox python3 python3-venv" >&2
        echo "  Arch:          sudo pacman -S ffmpeg sox python" >&2
        exit 1
    fi

    # Auto-setup bundled venv if needed
    if [[ ! -x "$PYTHON" ]]; then
        echo -e "${CYAN}First run — setting up Python environment...${RESET}" >&2
        python3 -m venv "$VENV_DIR"
        "$VENV_DIR/bin/pip" install --quiet --upgrade pip
        "$VENV_DIR/bin/pip" install --quiet -r "${SCRIPT_DIR}/requirements.txt"
        echo -e "${GREEN}Done.${RESET}" >&2
        echo "" >&2
    fi
}

# ============================================================================
# Usage
# ============================================================================
usage() {
    cat <<'EOF'
Usage: sonogram [options] <input.wav>

Generate a video from a WAV audio recording with scrolling spectrogram,
playback cursor, and metadata overlay.

The program will interactively ask for metadata and settings.

Options:
  -q, --quick          Quick test mode: skip dialogue, use default metadata
  -c, --config FILE    Load settings from a key=value config file (non-interactive)
  -h, --help           Show this help message
EOF
    exit 0
}

# ============================================================================
# Parse datetime from BWF metadata, filename, or file timestamps
# ============================================================================
parse_datetime() {
    "$PYTHON" -c "
import re, os, sys, datetime, subprocess, json
filepath = sys.argv[1]

# Priority 1: BWF embedded metadata
try:
    result = subprocess.run(
        ['ffprobe', '-v', 'error', '-show_entries', 'format_tags',
         '-of', 'json', filepath],
        capture_output=True, text=True
    )
    tags = json.loads(result.stdout).get('format', {}).get('tags', {})
    orig_date = (tags.get('origination_date', '') or
                 tags.get('date', '') or '')
    orig_time = (tags.get('origination_time', '') or
                 tags.get('creation_time', '') or '')
    time_ref = tags.get('time_reference', '')

    # time_reference (samples since midnight) is the most accurate for
    # trimmed files — editors update it even when creation_time stays the same.
    # Always prefer it when available.
    if orig_date and time_ref:
        try:
            sr_out = subprocess.run(
                ['ffprobe', '-v', 'error', '-select_streams', 'a:0',
                 '-show_entries', 'stream=sample_rate', '-of', 'csv=p=0',
                 filepath],
                capture_output=True, text=True
            )
            sr = int(sr_out.stdout.strip())
            total_secs = int(time_ref) / sr
            h = int(total_secs // 3600)
            m = int((total_secs % 3600) // 60)
            s = int(total_secs % 60)
            orig_time = f'{h:02d}:{m:02d}:{s:02d}'
        except Exception:
            pass

    if orig_date and len(orig_date) >= 10:
        orig_date = orig_date[:10].replace(':', '-')
        if orig_time and len(orig_time) >= 8:
            print(f'{orig_date}T{orig_time[:8]}')
        elif orig_time and len(orig_time) >= 5:
            print(f'{orig_date}T{orig_time[:5]}:00')
        else:
            print(f'{orig_date}T00:00:00')
        sys.exit(0)
except Exception:
    pass

# Priority 2: Filename patterns
basename = os.path.splitext(os.path.basename(filepath))[0]
# ISO format with separators: 2026-03-08T07_47_03 or 2026-03-08T07-47-03
m = re.search(r'(\d{4})-(\d{2})-(\d{2})[T_\- ](\d{2})[_\-:](\d{2})[_\-:](\d{2})', basename)
if m:
    y,mo,d,h,mi,s = m.groups()
    if 1990 <= int(y) <= 2099:
        print(f'{y}-{mo}-{d}T{h}:{mi}:{s}')
        sys.exit(0)
# ISO format without seconds: 2026-04-04T04_26 or 2026-04-04T04:26
m = re.search(r'(\d{4})-(\d{2})-(\d{2})[T_\- ](\d{2})[_\-:](\d{2})(?!\d)', basename)
if m:
    y,mo,d,h,mi = m.groups()
    if 1990 <= int(y) <= 2099:
        print(f'{y}-{mo}-{d}T{h}:{mi}:00')
        sys.exit(0)
# Compact format: YYYYMMDD_HHMMSS or YYYYMMDDTHHMMSS
m = re.search(r'(\d{4})(\d{2})(\d{2})[_\-T](\d{2})(\d{2})(\d{2})', basename)
if m:
    y,mo,d,h,mi,s = m.groups()
    if 1990 <= int(y) <= 2099:
        print(f'{y}-{mo}-{d}T{h}:{mi}:{s}')
        sys.exit(0)
# Short year: YYMMDD_HHMMSS
m = re.search(r'(?<!\d)(\d{2})(\d{2})(\d{2})[_\-](\d{2})(\d{2})(\d{2})(?!\d)', basename)
if m:
    y,mo,d,h,mi,s = m.groups()
    c = '20' if int(y) < 80 else '19'
    print(f'{c}{y}-{mo}-{d}T{h}:{mi}:{s}')
    sys.exit(0)
# Fallback: file creation/modification time
try:
    stat = os.stat(filepath)
    # Use birth time if available, otherwise modification time
    ts = getattr(stat, 'st_birthtime', None) or stat.st_mtime
    dt = datetime.datetime.fromtimestamp(ts)
    print(dt.strftime('%Y-%m-%dT%H:%M:%S'))
    sys.exit(0)
except Exception:
    pass
print('')
" "$1"
}

# ============================================================================
# Probe audio file
# ============================================================================
probe_audio() {
    local input="$1"
    AUDIO_SAMPLE_RATE=$(ffprobe -v error -select_streams a:0 \
        -show_entries stream=sample_rate -of csv=p=0 "$input")
    AUDIO_CHANNELS=$(ffprobe -v error -select_streams a:0 \
        -show_entries stream=channels -of csv=p=0 "$input")
    AUDIO_DURATION=$(ffprobe -v error -select_streams a:0 \
        -show_entries format=duration -of csv=p=0 "$input")
    AUDIO_BIT_DEPTH=$(ffprobe -v error -select_streams a:0 \
        -show_entries stream=bits_per_raw_sample -of csv=p=0 "$input" 2>/dev/null || echo "")
    # Fallback: try bits_per_sample if bits_per_raw_sample is empty/N/A
    if [[ -z "$AUDIO_BIT_DEPTH" || "$AUDIO_BIT_DEPTH" == "N/A" ]]; then
        AUDIO_BIT_DEPTH=$(ffprobe -v error -select_streams a:0 \
            -show_entries stream=bits_per_sample -of csv=p=0 "$input" 2>/dev/null || echo "")
    fi
    # Detect float format from codec name
    local codec_name
    codec_name=$(ffprobe -v error -select_streams a:0 \
        -show_entries stream=codec_name -of csv=p=0 "$input" 2>/dev/null || echo "")
    codec_name="${codec_name%%[[:space:]]}"
    AUDIO_FORMAT=""
    case "$codec_name" in
        pcm_f32le|pcm_f32be|pcm_f64le|pcm_f64be)
            AUDIO_FORMAT="FLOAT"
            ;;
    esac
    if [[ -z "$AUDIO_BIT_DEPTH" || "$AUDIO_BIT_DEPTH" == "N/A" || "$AUDIO_BIT_DEPTH" == "0" ]]; then
        # Derive from codec name
        case "$codec_name" in
            pcm_f32*|pcm_s32*) AUDIO_BIT_DEPTH="32" ;;
            pcm_f64*)          AUDIO_BIT_DEPTH="64" ;;
            pcm_s24*)          AUDIO_BIT_DEPTH="24" ;;
            pcm_s16*|pcm_u16*) AUDIO_BIT_DEPTH="16" ;;
            pcm_s8*|pcm_u8*)   AUDIO_BIT_DEPTH="8" ;;
            *)                 AUDIO_BIT_DEPTH="16" ;;
        esac
    fi

    # Clean up
    AUDIO_SAMPLE_RATE="${AUDIO_SAMPLE_RATE%%[[:space:]]}"
    AUDIO_CHANNELS="${AUDIO_CHANNELS%%[[:space:]]}"
    AUDIO_DURATION="${AUDIO_DURATION%%[[:space:]]}"
    AUDIO_BIT_DEPTH="${AUDIO_BIT_DEPTH%%[[:space:]]}"

    if [[ -z "$AUDIO_DURATION" || "$AUDIO_DURATION" == "N/A" ]]; then
        AUDIO_DURATION=$(sox --info -D "$input" 2>/dev/null || echo "0")
    fi

    # Extract encoded_by from BWF metadata
    AUDIO_ENCODED_BY=$(ffprobe -v error -show_entries format_tags=encoded_by \
        -of csv=p=0 "$input" 2>/dev/null || echo "")
    AUDIO_ENCODED_BY="${AUDIO_ENCODED_BY%%[[:space:]]}"
}

# ============================================================================
# Extract iXML metadata from WAV file
# ============================================================================
load_ixml_metadata() {
    local input_file="$1"

    IXML_SCENE="" IXML_NOTE="" IXML_LOCATION="" IXML_COORDINATES=""
    IXML_RECORDER="" IXML_FOUND="n"

    eval "$("$PYTHON" -c "
import sys, struct, xml.etree.ElementTree as ET, re

def read_ixml(filepath):
    '''Read iXML chunk from WAV/RIFF file.'''
    with open(filepath, 'rb') as f:
        riff = f.read(4)
        if riff != b'RIFF':
            return None
        f.read(4)  # file size
        wave = f.read(4)
        if wave != b'WAVE':
            return None
        while True:
            chunk_hdr = f.read(8)
            if len(chunk_hdr) < 8:
                break
            chunk_id = chunk_hdr[:4]
            chunk_size = struct.unpack('<I', chunk_hdr[4:8])[0]
            if chunk_id == b'iXML':
                data = f.read(chunk_size)
                raw = data.split(b'\x00')[0]
                # Try UTF-8 first, fall back to Windows-1250 (Central/
                # Eastern European recorders), then ISO-8859-1 (never fails).
                for enc in ('utf-8', 'windows-1250', 'iso-8859-1'):
                    try:
                        return raw.decode(enc).lstrip('\ufeff')
                    except (UnicodeDecodeError, ValueError):
                        continue
                return raw.decode('utf-8', errors='replace').lstrip('\ufeff')
            else:
                # Skip chunk (pad to even boundary)
                f.seek(chunk_size + (chunk_size % 2), 1)
    return None

def sh(name, val):
    if val:
        val = str(val).strip()
        if not val:
            return
        val = val.replace(\"'\", \"'\\\"'\\\"'\")
        print(f\"{name}='{val}'\")

filepath = sys.argv[1]
xml_str = read_ixml(filepath)
if not xml_str:
    sys.exit(0)

try:
    root = ET.fromstring(xml_str)
except ET.ParseError:
    sys.exit(0)

print(\"IXML_FOUND='y'\")

# SCENE → subject
scene = root.findtext('SCENE', '') or ''
sh('IXML_SCENE', scene)

# NOTE → free-text description (first line as summary)
note = root.findtext('NOTE', '') or ''
sh('IXML_NOTE', note.split(chr(10))[0] if note else '')

# Location — nested inside <LOCATION> parent
loc_name = (root.findtext('LOCATION/LOCATION_NAME', '') or
            root.findtext('LOCATION_NAME', '') or '')
# Shorten country names to ISO 3166-1 alpha-2 codes
_countries = {
    'afghanistan':'AF','albania':'AL','algeria':'DZ','argentina':'AR',
    'armenia':'AM','australia':'AU','austria':'AT','azerbaijan':'AZ',
    'belarus':'BY','belgium':'BE','bolivia':'BO','bosnia and herzegovina':'BA',
    'brazil':'BR','bulgaria':'BG','cambodia':'KH','canada':'CA',
    'chile':'CL','china':'CN','colombia':'CO','costa rica':'CR',
    'croatia':'HR','cuba':'CU','cyprus':'CY','czech republic':'CZ',
    'czechia':'CZ','denmark':'DK','ecuador':'EC','egypt':'EG',
    'estonia':'EE','ethiopia':'ET','finland':'FI','france':'FR',
    'georgia':'GE','germany':'DE','greece':'GR','guatemala':'GT',
    'hungary':'HU','iceland':'IS','india':'IN','indonesia':'ID',
    'iran':'IR','iraq':'IQ','ireland':'IE','israel':'IL','italy':'IT',
    'japan':'JP','jordan':'JO','kazakhstan':'KZ','kenya':'KE',
    'korea':'KR','south korea':'KR','north korea':'KP',
    'kosovo':'XK','kuwait':'KW','kyrgyzstan':'KG','latvia':'LV',
    'lebanon':'LB','libya':'LY','liechtenstein':'LI','lithuania':'LT',
    'luxembourg':'LU','malaysia':'MY','malta':'MT','mexico':'MX',
    'moldova':'MD','monaco':'MC','mongolia':'MN','montenegro':'ME',
    'morocco':'MA','nepal':'NP','netherlands':'NL','new zealand':'NZ',
    'nigeria':'NG','north macedonia':'MK','norway':'NO','oman':'OM',
    'pakistan':'PK','panama':'PA','paraguay':'PY','peru':'PE',
    'philippines':'PH','poland':'PL','portugal':'PT','qatar':'QA',
    'romania':'RO','russia':'RU','saudi arabia':'SA','serbia':'RS',
    'singapore':'SG','slovakia':'SK','slovenia':'SI','south africa':'ZA',
    'spain':'ES','sri lanka':'LK','sweden':'SE','switzerland':'CH',
    'taiwan':'TW','tajikistan':'TJ','tanzania':'TZ','thailand':'TH',
    'tunisia':'TN','turkey':'TR','turkmenistan':'TM','ukraine':'UA',
    'united arab emirates':'AE','united kingdom':'GB','uk':'GB',
    'united states':'US','usa':'US','uruguay':'UY','uzbekistan':'UZ',
    'venezuela':'VE','vietnam':'VN',
}
if loc_name:
    parts = [p.strip() for p in loc_name.split(',')]
    for i, p in enumerate(parts):
        code = _countries.get(p.lower())
        if code:
            parts[i] = code
    loc_name = ', '.join(parts)
sh('IXML_LOCATION', loc_name)

loc_gps = (root.findtext('LOCATION/LOCATION_GPS', '') or
           root.findtext('LOCATION_GPS', '') or '')
if loc_gps:
    # Expect 'lat, lon' in decimal degrees
    sh('IXML_COORDINATES', loc_gps)

# USER field — parse key-value pairs
user = root.findtext('USER', '') or ''
recordist = ''
equipment = ''
mic_parts = []
for line in user.split(chr(10)):
    line = line.strip()
    if line.lower().startswith('recordist:'):
        recordist = line.split(':', 1)[1].strip()
    elif line.lower().startswith('recorder:') or line.lower().startswith('equipment:'):
        equipment = re.sub(r'\s*\(fw[^)]*\)', '', line.split(':', 1)[1].strip())
    elif line.lower().startswith('microphone') or line.lower().startswith('mic'):
        raw = line.split(':', 1)[1].strip() if ':' in line else ''
        # May contain multiple mics separated by ';'
        for entry in raw.split(';'):
            entry = entry.strip()
            if entry:
                mic_parts.append(entry)

# Clean mic entries: strip channel numbers (1), (2) and polar patterns
_patterns = set(['cardioid','supercardioid','hypercardioid','omnidirectional',
             'omni','figure-8','figure8','bidirectional','shotgun'])
def clean_mic(s):
    import re
    s = re.sub(r'\s*\(\d+\)', '', s)  # strip (1), (2), etc.
    parts = [p.strip().rstrip(',') for p in s.split(',')]
    parts = [p for p in parts if p.lower() not in _patterns and p]
    return ' '.join(parts).strip()

rec_str = equipment
if mic_parts:
    cleaned = [clean_mic(m) for m in mic_parts]
    cleaned = [m for m in cleaned if m]
    unique = list(dict.fromkeys(cleaned))
    if len(cleaned) > 1 and len(unique) == 1:
        mic_str = unique[0] + (' (PAIR)' if len(cleaned) == 2 else f' (x{len(cleaned)})')
    else:
        mic_str = ' + '.join(unique)
    if rec_str and mic_str:
        rec_str = rec_str + ' + ' + mic_str
    elif mic_str:
        rec_str = mic_str
sh('IXML_RECORDER', rec_str or recordist)
" "$input_file")"
}

# ============================================================================
# Load session.frm.txt sidecar metadata
# ============================================================================
load_frm_metadata() {
    local input_file="$1"
    local input_dir
    input_dir=$(dirname "$input_file")
    local frm_file="${input_dir}/session.frm.txt"

    FRM_TITLE="" FRM_RECORDER="" FRM_LOCATION="" FRM_COORDINATES=""
    FRM_DATETIME="" FRM_FOUND="n"

    [[ -f "$frm_file" ]] || return 0

    eval "$("$PYTHON" -c "
import yaml, sys, os, re
from datetime import datetime as DT

with open(sys.argv[1]) as f:
    doc = yaml.safe_load(f)

if not isinstance(doc, dict):
    sys.exit(0)

print(\"FRM_FOUND='y'\")

def sh(name, val):
    if val:
        val = str(val).strip()
        if not val:
            return
        val = val.replace(\"'\", \"'\\\"'\\\"'\")
        print(f\"{name}='{val}'\")

session = doc.get('session', {}) or {}
sh('FRM_TITLE', session.get('title', ''))

equip = doc.get('equipment', {}) or {}
recorder = equip.get('recorder', {}) or {}
mics = equip.get('microphones', []) or []
rec_model = recorder.get('model', '')
mic_models = [m.get('model', '') for m in mics if m.get('model')]
# Deduplicate: if all mics are the same model, show "Model (PAIR)" or "Model (x3)"
unique_mics = list(dict.fromkeys(mic_models))
if len(mic_models) > 1 and len(unique_mics) == 1:
    mic_str = unique_mics[0] + (' (PAIR)' if len(mic_models) == 2 else f' (x{len(mic_models)})')
elif unique_mics:
    mic_str = ' + '.join(unique_mics)
else:
    mic_str = ''
if rec_model and mic_str:
    sh('FRM_RECORDER', rec_model + ' + ' + mic_str)
elif rec_model:
    sh('FRM_RECORDER', rec_model)
elif mic_str:
    sh('FRM_RECORDER', mic_str)

loc = doc.get('location', {}) or {}
parts = [loc.get('name', ''), loc.get('region', '')]
loc_str = ', '.join(p for p in parts if p)
sh('FRM_LOCATION', loc_str)

lat = loc.get('latitude')
lon = loc.get('longitude')
if lat is not None and lon is not None:
    sh('FRM_COORDINATES', f'{lat}, {lon}')

def to_naive_iso(ts):
    if isinstance(ts, DT):
        return ts.strftime('%Y-%m-%dT%H:%M:%S')
    s = re.sub(r'[+-]\d{2}:\d{2}$', '', str(ts))
    return s.rstrip('Z')

dt = doc.get('datetime', {}) or {}
start = dt.get('start', '')
if start:
    sh('FRM_DATETIME', to_naive_iso(start))

# Per-file start time overrides session start
basename = os.path.basename(sys.argv[2])
files = doc.get('files', []) or []
for fentry in files:
    if not isinstance(fentry, dict):
        continue
    if fentry.get('filename', '') == basename:
        fstart = fentry.get('start')
        if fstart:
            sh('FRM_DATETIME', to_naive_iso(fstart))
        break
" "$frm_file" "$input_file")"
}

# ============================================================================
# Interactive dialogue
# ============================================================================
msg() {
    # Print to stderr (visible to user, not captured by subshells)
    echo -e "$@" >&2
}

ask() {
    local prompt="$1"
    local default="${2:-}"
    local result

    if [[ -n "$default" ]]; then
        msg -n "${CYAN}${prompt}${RESET} ${DIM}[${default}]${RESET}: "
    else
        msg -n "${CYAN}${prompt}${RESET}: "
    fi

    read -r result

    if [[ -z "$result" ]]; then
        result="$default"
    fi
    echo "$result"
}

interactive_dialogue() {
    local input_file="$1"
    local basename
    basename=$(basename "$input_file")

    # Load metadata sources: iXML from WAV, session.frm.txt sidecar
    load_ixml_metadata "$input_file"
    load_frm_metadata "$input_file"

    msg ""
    msg "${BOLD}╔══════════════════════════════════════════════════════╗${RESET}"
    msg "${BOLD}║       SONOGRAM                                       ║${RESET}"
    msg "${BOLD}╚══════════════════════════════════════════════════════╝${RESET}"
    msg ""
    msg "${DIM}File: ${RESET}${BOLD}${basename}${RESET}"
    msg "${DIM}Sample rate: ${AUDIO_SAMPLE_RATE} Hz | Channels: ${AUDIO_CHANNELS} | Duration: ${AUDIO_DURATION}s${RESET}"
    if [[ "$IXML_FOUND" == "y" ]]; then
        msg "${GREEN}Found iXML metadata in WAV file${RESET}"
    fi
    if [[ "$FRM_FOUND" == "y" ]]; then
        msg "${GREEN}Found session.frm.txt — metadata loaded${RESET}"
    fi

    # ------------------------------------------------------------------
    # 1. Recording metadata
    # ------------------------------------------------------------------
    msg ""
    msg "${BOLD}── Metadata ──${RESET}"

    # Date/time: BWF timecode > FRM file-specific start > FRM session start > filename > file stat
    local detected_datetime
    detected_datetime=$(parse_datetime "$input_file")
    local has_timecode="n"
    if [[ -n "$detected_datetime" && "$detected_datetime" == *T??:??:?? ]]; then
        msg "${GREEN}Detected date/time: ${detected_datetime}${RESET}"
        META_DATETIME="$detected_datetime"
        has_timecode="y"
    elif [[ -n "$FRM_DATETIME" && "$FRM_DATETIME" == *T??:??:?? ]]; then
        msg "${GREEN}Date/time from session.frm.txt: ${FRM_DATETIME}${RESET}"
        META_DATETIME="$FRM_DATETIME"
        has_timecode="y"
    elif [[ -n "$FRM_DATETIME" ]]; then
        local frm_date="${FRM_DATETIME%%T*}"
        msg "${GREEN}Date from session.frm.txt: ${frm_date}${RESET}"
        msg "${DIM}No embedded timecode found. Enter precise start time if known.${RESET}"
        local user_time
        user_time=$(ask "Start time (HH:MM:SS, or Enter to show date only)" "")
        if [[ -n "$user_time" ]]; then
            META_DATETIME="${frm_date}T${user_time}"
            has_timecode="y"
        else
            META_DATETIME="$frm_date"
        fi
    elif [[ -n "$detected_datetime" ]]; then
        local detected_date="${detected_datetime%%T*}"
        msg "${GREEN}Detected date: ${detected_date}${RESET}"
        msg "${DIM}No embedded timecode found. Enter precise start time if known.${RESET}"
        local user_time
        user_time=$(ask "Start time (HH:MM:SS, or Enter to show date only)" "")
        if [[ -n "$user_time" ]]; then
            META_DATETIME="${detected_date}T${user_time}"
            has_timecode="y"
        else
            META_DATETIME="$detected_date"
        fi
    else
        msg "${YELLOW}Could not detect date/time.${RESET}"
        META_DATETIME=$(ask "Date/time (ISO format, e.g. 2024-03-15T14:30:22, or Enter to skip)" "")
    fi

    # Metadata defaults: FRM > iXML > BWF/empty
    local def_subject="${FRM_TITLE:-${IXML_SCENE:-${IXML_NOTE}}}"
    local def_recorder="${FRM_RECORDER:-${IXML_RECORDER:-$AUDIO_ENCODED_BY}}"
    local def_location="${FRM_LOCATION:-$IXML_LOCATION}"
    local def_coordinates="${FRM_COORDINATES:-$IXML_COORDINATES}"

    META_SUBJECT=$(ask "Recorded subject" "$def_subject")
    META_RECORDER=$(ask "Recorded with" "$def_recorder")
    META_LOCATION=$(ask "Location (optional, Enter to skip)" "$def_location")
    if [[ -n "$META_LOCATION" ]]; then
        META_COORDINATES=$(ask "Coordinates for map (lat,lon, Enter to skip)" "$def_coordinates")
    else
        META_COORDINATES=""
    fi

    # ------------------------------------------------------------------
    # 2. Audio processing
    # ------------------------------------------------------------------
    msg ""
    msg "${BOLD}── Audio ──${RESET}"

    msg "${DIM}Playback speed: reinterpret sample rate for ultrasonic content.${RESET}"
    msg "${DIM}Format: SOURCE:TARGET (e.g. 192000:44100) or divisor (e.g. 4.35)${RESET}"
    PLAYBACK_SPEED_INPUT=$(ask "Playback speed" "1x")
    NORMALIZE_AUDIO=$(ask "Normalize audio to -16 LUFS? (y/n)" "y")

    # ------------------------------------------------------------------
    # 3. Spectrogram
    # ------------------------------------------------------------------
    msg ""
    msg "${BOLD}── Spectrogram ──${RESET}"

    msg "${DIM}standard: classic STFT | reassigned: sharper ridges (3x slower)${RESET}"
    SPEC_METHOD=$(ask "Method (standard / reassigned)" "standard")

    local nyquist=$((AUDIO_SAMPLE_RATE / 2))
    msg "${DIM}Nyquist: ${nyquist} Hz${RESET}"
    FREQ_MIN=$(ask "Freq min (Hz)" "20")
    FREQ_MAX=$(ask "Freq max (Hz)" "$nyquist")

    local fft_default="2048"
    if [[ "$SPEC_METHOD" == "reassigned" ]]; then
        msg "${DIM}Reassigned recovers frequency detail from smaller windows.${RESET}"
        msg "${DIM}512: birdsong, fast trills | 1024: general | 2048: tonal, slow${RESET}"
        fft_default="512"
    else
        msg "${DIM}Larger = sharper frequency, blurrier time. Smaller = opposite.${RESET}"
        msg "${DIM}1024: birdsong | 2048: general | 4096+: tonal, slow${RESET}"
        fft_default="2048"
    fi
    FFT_WINDOW=$(ask "FFT window size (512 / 1024 / 2048 / 4096 / 8192)" "$fft_default")

    msg "${DIM}Pixels per second of audio. Higher = more detail, wider image.${RESET}"
    msg "${DIM}50-100: long ambient | 200: general | 400-800: bird calls${RESET}"
    SPEC_PPS=$(ask "Detail (pixels/sec)" "200")

    msg "${DIM}Lower = more contrast. 40-60: detailed patterns | 90: wide dynamic range${RESET}"
    DYNAMIC_RANGE=$(ask "Dynamic range (dB)" "55")

    # ------------------------------------------------------------------
    # 4. Output
    # ------------------------------------------------------------------
    msg ""
    msg "${BOLD}── Output ──${RESET}"

    PRESET=$(ask "Preset (ig_reel / reel / square / landscape / cf-u1 / cf-33)" "ig_reel")
    if [[ ! -f "${PRESETS_DIR}/${PRESET}.conf" ]]; then
        msg "${YELLOW}Unknown preset '${PRESET}', defaulting to ig_reel.${RESET}"
        PRESET="ig_reel"
    fi

    PHOTO_PATH=$(ask "Photo path (optional, Enter to skip)" "")
    if [[ -n "$PHOTO_PATH" && ! -f "$PHOTO_PATH" ]]; then
        msg "${YELLOW}Photo file not found: ${PHOTO_PATH}. Skipping.${RESET}"
        PHOTO_PATH=""
    fi

    if [[ "$has_timecode" == "y" ]]; then
        SHOW_TIMECODE="y"
        msg "${DIM}Running timecode: enabled (embedded timecode detected)${RESET}"
    else
        SHOW_TIMECODE=$(ask "Show running timecode? (y/n)" "n")
    fi

    local default_output="${input_file%.*}_video.mp4"
    OUTPUT_FILE=$(ask "Output filename" "$default_output")

    msg ""
}

# ============================================================================
# Parse playback speed
# ============================================================================
parse_playback_speed() {
    local input="$1"
    local orig_sr="$2"

    if [[ "$input" == "1x" || "$input" == "1" || -z "$input" ]]; then
        SPEED_FACTOR="1"
        EFFECTIVE_RATE="$orig_sr"
        PLAYBACK_LABEL="1x (native)"
        return
    fi

    # Check for ratio format (SOURCE:TARGET)
    if [[ "$input" == *":"* ]]; then
        local source_rate="${input%%:*}"
        local target_rate="${input##*:}"
        SPEED_FACTOR=$("$PYTHON" -c "print(f'{${source_rate}/${target_rate}:.6f}')")
        EFFECTIVE_RATE="$target_rate"
        PLAYBACK_LABEL="${source_rate}Hz → ${target_rate}Hz (${SPEED_FACTOR}× slower)"
    else
        # Divisor format
        SPEED_FACTOR="$input"
        EFFECTIVE_RATE=$("$PYTHON" -c "print(int(${orig_sr} / ${input}))")
        PLAYBACK_LABEL="${input}× slower"
    fi
}

# ============================================================================
# Prepare audio with playback speed reinterpretation
# ============================================================================
prepare_audio() {
    local input="$1"
    local output="$2"
    local effective_rate="$3"
    local speed_factor="$4"
    local normalize="$5"

    local af_chain=""

    if [[ "$speed_factor" != "1" ]]; then
        af_chain="asetrate=${effective_rate},aresample=48000"
    fi

    if [[ "$normalize" == "y" || "$normalize" == "Y" || "$normalize" == "yes" ]]; then
        # Measure integrated loudness, then apply a fixed gain offset.
        # No dynamic compression — preserves original dynamics completely.
        local measure_output
        if [[ -n "$af_chain" ]]; then
            measure_output=$(ffmpeg -hide_banner -i "$input" \
                -af "${af_chain},loudnorm=I=-16:TP=-1.5:LRA=50:print_format=json" \
                -f null - 2>&1)
        else
            measure_output=$(ffmpeg -hide_banner -i "$input" \
                -af "loudnorm=I=-16:TP=-1.5:LRA=50:print_format=json" \
                -f null - 2>&1)
        fi

        local gain_db
        gain_db=$("$PYTHON" -c "
import sys, json, re
text = sys.stdin.read()
m = re.search(r'\{[^{}]+\}', text, re.DOTALL)
if m:
    d = json.loads(m.group())
    measured_i = float(d['input_i'])
    measured_tp = float(d['input_tp'])
    target_i = -16.0
    target_tp = -1.5
    # Gain needed for target loudness
    gain = target_i - measured_i
    # Clamp so true peak doesn't exceed limit
    headroom = target_tp - measured_tp
    if gain > headroom:
        gain = headroom
    print(f'{gain:.2f}')
else:
    print('0.00', file=sys.stderr)
    print('0.00')
" <<< "$measure_output")

        local volume_filter="volume=${gain_db}dB"

        if [[ -n "$af_chain" ]]; then
            af_chain="${af_chain},${volume_filter}"
        else
            af_chain="${volume_filter}"
        fi
    fi

    if [[ -n "$af_chain" ]]; then
        ffmpeg -y -v warning -i "$input" \
            -af "$af_chain" \
            -ar 48000 -c:a pcm_s24le "$output"
    else
        ffmpeg -y -v warning -i "$input" \
            -ar 48000 -c:a pcm_s24le "$output"
    fi
}

# ============================================================================
# Calculate spectrogram dimensions
# ============================================================================
calc_spec_dimensions() {
    local duration="$1"
    local viewport_w="$2"
    local pps="${3:-200}"
    local total_w
    total_w=$("$PYTHON" -c "
import math
d = ${duration}
pps = ${pps}
w = int(math.ceil(pps * d))
w = max(w, ${viewport_w})
w = min(w, 300000)
print(w)
")
    echo "$total_w"
}

# ============================================================================
# Build ffmpeg filter graph
# ============================================================================
generate_cursor_image() {
    local output="$1"
    local height="$2"
    "$PYTHON" -c "
from PIL import Image, ImageFilter
import numpy as np
# Cursor: bright core with glow
w = 21
h = ${height}
img = Image.new('RGBA', (w, h), (0, 0, 0, 0))
pixels = np.array(img)
# Glow layers (symmetric around center at x=10)
for dx in range(-10, 11):
    dist = abs(dx)
    if dist <= 1:
        alpha = 240
        r, g, b = 0, 255, 120
    elif dist <= 3:
        alpha = 80
        r, g, b = 200, 255, 220
    elif dist <= 6:
        alpha = 35
        r, g, b = 255, 255, 255
    else:
        alpha = 12
        r, g, b = 255, 255, 255
    x = 10 + dx
    if 0 <= x < w:
        pixels[:, x] = [r, g, b, alpha]
Image.fromarray(pixels).save('${output}')
"
}

build_ffmpeg_command() {
    local spec_png="$1"
    local info_png="$2"
    local audio="$3"
    local output="$4"
    local photo="$5"
    local spec_total_w="$6"
    local viewport_w="$7"
    local spec_h="$8"
    local info_h="$9"
    local duration="${10}"
    local fps="${11}"
    local video_w="${12}"
    local video_h="${13}"
    local photo_band_h="${14}"
    local freq_scale_png="${15}"
    local timecode_datetime="${16}"
    local speed_factor="${17}"
    local font_size="${18}"
    local timecode_x="${19}"
    local timecode_y="${20}"

    # Generate cursor image
    local cursor_png="${TMPDIR}/cursor.png"
    generate_cursor_image "$cursor_png" "$spec_h"

    # Scroll rate: pixels per second
    local scroll_rate
    scroll_rate=$("$PYTHON" -c "print(f'{${spec_total_w} / ${duration}:.6f}')")

    # Half viewport
    local half_vw
    half_vw=$("$PYTHON" -c "print(${viewport_w} / 2.0)")

    # Crop expression: x = clip(scroll_rate*t - viewport/2, 0, total_w - viewport_w)
    local crop_x="min(max(0,${scroll_rate}*t-${half_vw}),${spec_total_w}-${viewport_w})"

    # Cursor x position in viewport (for overlay filter, which supports dynamic expressions)
    local cursor_x="(${scroll_rate}*t)-min(max(0,${scroll_rate}*t-${half_vw}),${spec_total_w}-${viewport_w})-10"

    # Extra parameters (21+)
    local scroll_value_x="${21:-}"
    local scroll_max_chars="${22:-32}"
    local map_frames_dir="${23:-}"
    local map_x="${24:-}"
    local map_y="${25:-}"
    local map_size="${26:-}"
    local -a scroll_fields_arr=()
    shift 26 2>/dev/null || true
    while [[ $# -gt 0 ]]; do
        scroll_fields_arr+=("$1")
        shift
    done

    local filter_complex=""
    local inputs=()

    inputs+=(-framerate "$fps" -loop 1 -i "$spec_png")       # [0] spectrogram
    inputs+=(-framerate "$fps" -loop 1 -i "$info_png")       # [1] info panel
    inputs+=(-i "$audio")                                    # [2] audio
    inputs+=(-framerate "$fps" -loop 1 -i "$cursor_png")     # [3] cursor
    inputs+=(-framerate "$fps" -loop 1 -i "$freq_scale_png") # [4] frequency scale overlay

    local next_idx=5
    local photo_idx=""
    local map_anim_idx=""
    if [[ -n "$photo" ]]; then
        inputs+=(-framerate "$fps" -loop 1 -i "$photo")
        photo_idx="$next_idx"
        next_idx=$((next_idx + 1))
    fi
    if [[ -n "$map_frames_dir" && -d "$map_frames_dir" ]]; then
        inputs+=(-framerate "$fps" -i "${map_frames_dir}/map_%06d.png")
        map_anim_idx="$next_idx"
        next_idx=$((next_idx + 1))
    fi

    # Build filter: crop spectrogram, overlay cursor, overlay freq scale, stack with info panel
    filter_complex="[0:v]crop=w=${viewport_w}:h=${spec_h}:x='${crop_x}':y=0[spec_cropped];"
    filter_complex+="[3:v]loop=-1:size=1[cur_loop];"
    filter_complex+="[spec_cropped][cur_loop]overlay=x='${cursor_x}':y=0:shortest=1[spec_cursor];"
    filter_complex+="[4:v]loop=-1:size=1[scale_loop];"
    filter_complex+="[spec_cursor][scale_loop]overlay=x=0:y=0:shortest=1[spec_final];"
    filter_complex+="[1:v]scale=${viewport_w}:${info_h}[info];"

    local safe_top="${SAFE_TOP:-0}"
    local safe_bottom="${SAFE_BOTTOM:-0}"

    if [[ -n "$photo" ]]; then
        filter_complex+="[${photo_idx}:v]scale=${viewport_w}:${photo_band_h}:force_original_aspect_ratio=decrease,"
        filter_complex+="pad=${viewport_w}:${photo_band_h}:(ow-iw)/2:(oh-ih)/2:color=black[photo_scaled];"
        filter_complex+="[info][spec_final]vstack[top];"
        filter_complex+="[top][photo_scaled]vstack[content];"
    else
        filter_complex+="[info][spec_final]vstack[content];"
    fi

    # Pad content into full video frame (safe zone margins)
    if [[ "$safe_top" -gt 0 || "$safe_bottom" -gt 0 ]]; then
        filter_complex+="[content]pad=${video_w}:${video_h}:0:${safe_top}:black[combined];"
    else
        filter_complex+="[content]copy[combined];"
    fi

    # Overlay map animation on info panel if available
    if [[ -n "$map_anim_idx" ]]; then
        local map_y_adj=$((map_y + safe_top))
        filter_complex+="[combined][${map_anim_idx}:v]overlay=x=${map_x}:y=${map_y_adj}:shortest=1[map_combined];"
        local combined_label="map_combined"
    else
        local combined_label="combined"
    fi

    # Chain of drawtext filters
    local dt_font="${LIB_DIR}/VCR_OSD_MONO.ttf"
    if [[ ! -f "$dt_font" ]]; then
        dt_font="/usr/share/fonts/truetype/dejavu/DejaVuSansMono-Bold.ttf"
    fi

    local dt_in="$combined_label"
    local dt_idx=0

    # Scrolling text via chained drawtext filters (1 char/sec, like timecode)
    if [[ ${#scroll_fields_arr[@]} -gt 0 ]]; then
        for sf in "${scroll_fields_arr[@]}"; do
            # Format: scroll_field=Y_POS:ESCAPED_TEXT
            local sf_data="${sf#scroll_field=}"
            local sf_y="${sf_data%%:*}"
            sf_y=$((sf_y + safe_top))
            local sf_text="${sf_data#*:}"
            # Unescape from Python output
            sf_text="${sf_text//\\\\:/\:}"
            sf_text="${sf_text//\\\\\\\\/\\\\}"

            # Generate chained drawtext filters via Python
            # One filter per unique scroll position (one text cycle), using
            # modular enable so it loops for the full video duration
            local scroll_filters
            scroll_filters=$("$PYTHON" -c "
import sys
text = sys.argv[1]
max_chars = int(sys.argv[2])
y = sys.argv[4]
x = sys.argv[5]
font = sys.argv[6]
font_size = sys.argv[7]
dt_in = sys.argv[8]
dt_idx = int(sys.argv[9])

# Build looping text with dash delimiter
loop_text = text + ' - ' + text
cycle_len = len(text) + 3  # text + ' - '

filters = ''
for pos in range(cycle_len):
    window = loop_text[pos:pos + max_chars]
    if len(window) < max_chars:
        window += loop_text[:max_chars - len(window)]

    # Escape for ffmpeg drawtext
    window = window.replace('\\\\', '\\\\\\\\')
    window = window.replace(\"'\", \"'\\\\\\\\''\")
    window = window.replace(':', '\\\\:')

    dt_out = f'stxt_{dt_idx}_{pos}'
    # max(0,floor(t)-5) holds at 0 for t<5 then advances 1/sec.
    # No if() branch — avoids evaluation glitches at transition.
    ec = chr(92) + ','  # escaped comma for ffmpeg
    enable = f\"enable='eq(mod(max(0{ec}floor(t)-5){ec}{cycle_len}){ec}{pos})'\"

    filters += f'[{dt_in}]drawtext='
    filters += f'fontfile={font}:'
    filters += f'fontsize={font_size}:'
    filters += f'fontcolor=0xE6E6E6:'
    filters += f'x={x}:y={y}:'
    filters += f\"text='{window}':\"
    filters += f'{enable}'
    filters += f'[{dt_out}];'

    dt_in = dt_out

print(filters)
print(f'LAST_LABEL={dt_in}')
print(f'LAST_IDX={dt_idx}')
" "$sf_text" "$scroll_max_chars" "$duration" "$sf_y" "$scroll_value_x" "$dt_font" "$font_size" "$dt_in" "$dt_idx")

            # Extract the filter text and updated label/index
            local filters_text
            filters_text=$(echo "$scroll_filters" | head -1)
            dt_in=$(echo "$scroll_filters" | grep "^LAST_LABEL=" | cut -d= -f2)
            dt_idx=$(echo "$scroll_filters" | grep "^LAST_IDX=" | cut -d= -f2)

            filter_complex+="$filters_text"
        done
    fi

    # Dynamic timecode in info panel via drawtext
    local tc_y_adj=$((timecode_y + safe_top))
    if [[ -n "$timecode_datetime" && -n "$timecode_x" && "$timecode_x" != "0" ]]; then
        local tc_epoch
        tc_epoch=$("$PYTHON" -c "
import datetime, sys
dt_str = '${timecode_datetime}'
for fmt in ('%Y-%m-%dT%H:%M:%S', '%Y-%m-%d %H:%M:%S', '%Y-%m-%dT%H:%M', '%Y-%m-%d'):
    try:
        dt = datetime.datetime.strptime(dt_str, fmt)
        print(int(dt.timestamp()))
        sys.exit(0)
    except ValueError:
        continue
print(0)
")

        if [[ "$tc_epoch" != "0" ]]; then
            filter_complex+="[${dt_in}]setpts=PTS/${speed_factor}[tc_scaled];"
            filter_complex+="[tc_scaled]drawtext="
            filter_complex+="fontfile=${dt_font}:"
            filter_complex+="fontsize=${font_size}:"
            filter_complex+="fontcolor=0xE6E6E6:"
            filter_complex+="x=${timecode_x}:y=${tc_y_adj}:"
            filter_complex+="text='%{pts\:localtime\:${tc_epoch}\:%Y-%m-%dT%H\\\\\:%M\\\\\:%S}'"
            filter_complex+="[tc_drawn];"
            filter_complex+="[tc_drawn]setpts=PTS*${speed_factor}[final_dt];"
            filter_complex+="[final_dt]format=yuv420p[outv]"
        else
            filter_complex+="[${dt_in}]format=yuv420p[outv]"
        fi
    else
        filter_complex+="[${dt_in}]format=yuv420p[outv]"
    fi

    # Build encoding flags from preset overrides
    local -a enc_flags=(-c:v libx264 -preset "$H264_PRESET" -crf "$H264_CRF")
    if [[ "$H264_PROFILE" != "high" ]]; then enc_flags+=(-profile:v "$H264_PROFILE"); fi
    if [[ -n "$H264_LEVEL" ]]; then enc_flags+=(-level:v "$H264_LEVEL"); fi
    if [[ -n "$H264_BFRAMES" ]]; then enc_flags+=(-bf "$H264_BFRAMES"); fi
    if [[ -n "$H264_REFS" ]]; then enc_flags+=(-refs "$H264_REFS"); fi
    if [[ -n "$H264_EXTRA_PARAMS" ]]; then enc_flags+=(-x264-params "$H264_EXTRA_PARAMS"); fi
    enc_flags+=(-c:a aac -b:a "$AUDIO_BITRATE")
    if [[ -n "$AUDIO_SAMPLE_RATE" ]]; then enc_flags+=(-ar "$AUDIO_SAMPLE_RATE"); fi
    if [[ -n "$AUDIO_CHANNELS" ]]; then enc_flags+=(-ac "$AUDIO_CHANNELS"); fi

    ffmpeg -y -v warning -stats_period 0.5 -progress pipe:1 \
        "${inputs[@]}" \
        -filter_complex "$filter_complex" \
        -map "[outv]" -map 2:a \
        "${enc_flags[@]}" \
        -r "$fps" \
        -t "$duration" \
        -movflags +faststart \
        -shortest \
        "$output" | "$PYTHON" -c "
import sys

duration = float('${duration}')
bar_width = 40

for line in sys.stdin:
    line = line.strip()
    if line.startswith('out_time_ms='):
        try:
            us = int(line.split('=')[1])
            secs = us / 1_000_000.0
            pct = min(secs / duration, 1.0) if duration > 0 else 0
            filled = int(bar_width * pct)
            bar = '█' * filled + '░' * (bar_width - filled)
            elapsed = f'{secs:.1f}s / {duration:.1f}s'
            print(f'\r        {bar} {pct*100:5.1f}%  {elapsed}', end='', flush=True, file=sys.stderr)
        except (ValueError, ZeroDivisionError):
            pass
    elif line == 'progress=end':
        print(f'\r        {\"█\" * bar_width} 100.0%  Done!{\" \" * 20}', file=sys.stderr)
"
}

# ============================================================================
# Load config file (non-interactive mode)
# ============================================================================
load_config() {
    local config_file="$1"
    local input_file="$2"

    if [[ ! -f "$config_file" ]]; then
        echo -e "${RED}ERROR: Config file not found: ${config_file}${RESET}" >&2
        exit 1
    fi

    # Whitelist of known variables that may appear in the config file
    local -a allowed_vars=(
        INPUT DATETIME SUBJECT RECORDER LOCATION COORDINATES
        FREQ_MIN FREQ_MAX FFT_WINDOW SPEC_METHOD SPEC_PPS DYNAMIC_RANGE
        PLAYBACK_SPEED_INPUT NORMALIZE_AUDIO PRESET PHOTO_PATH
        SHOW_TIMECODE OUTPUT_FILE
    )

    # Read config file line by line, only setting allowed variables
    while IFS='=' read -r key value; do
        # Skip blank lines and comments
        [[ -z "$key" || "$key" =~ ^[[:space:]]*# ]] && continue
        # Trim whitespace from key
        key=$(echo "$key" | tr -d '[:space:]')
        local allowed=false
        for v in "${allowed_vars[@]}"; do
            if [[ "$key" == "$v" ]]; then
                allowed=true
                break
            fi
        done
        if [[ "$allowed" == true ]]; then
            # Use printf to handle values safely (eval only the assignment)
            printf -v "$key" '%s' "$value"
        fi
    done < "$config_file"

    # Map config keys to the internal variable names used by the pipeline
    local nyquist=$((AUDIO_SAMPLE_RATE / 2))

    META_DATETIME="${DATETIME:-$(date +%Y-%m-%dT%H:%M:%S)}"
    META_SUBJECT="${SUBJECT:-}"
    META_RECORDER="${RECORDER:-Unknown}"
    META_LOCATION="${LOCATION:-}"
    META_COORDINATES="${COORDINATES:-}"
    FREQ_MIN="${FREQ_MIN:-20}"
    FREQ_MAX="${FREQ_MAX:-$nyquist}"
    PLAYBACK_SPEED_INPUT="${PLAYBACK_SPEED_INPUT:-1x}"
    PRESET="${PRESET:-ig_reel}"
    PHOTO_PATH="${PHOTO_PATH:-}"
    FFT_WINDOW="${FFT_WINDOW:-2048}"
    SPEC_METHOD="${SPEC_METHOD:-standard}"
    SPEC_PPS="${SPEC_PPS:-200}"
    DYNAMIC_RANGE="${DYNAMIC_RANGE:-55}"
    NORMALIZE_AUDIO="${NORMALIZE_AUDIO:-y}"
    SHOW_TIMECODE="${SHOW_TIMECODE:-y}"
    OUTPUT_FILE="${OUTPUT_FILE:-${input_file%.*}_video.mp4}"

    msg ""
    msg "${BOLD}Config mode${RESET} — loaded settings from ${config_file}"
    msg "${DIM}Subject: ${META_SUBJECT} | Preset: ${PRESET} | FFT: ${FFT_WINDOW}${RESET}"
    msg ""
}

